# GLMM Model result!

# 1.) broad type

# frequency
broad_amplitude <- lmer(MI_all$MI_median_amp ~ broad_type + event_type + broad_type*event_type + 
            (1 | MI_all$record_date),data = MI_all)
summary(broad_amplitude)


# median amplitude
broad_frequency <- lmer(MI_all$MI_freq ~ broad_type + event_type + broad_type*event_type + 
            (1 | MI_all$record_date),data = MI_all)
summary(broad_frequency)


# 2.) narrow type

# frequency
narrow_frequency <- lmer(MI_all$MI_freq ~ narrow_type + event_type + narrow_type*event_type + 
            (1 | MI_all$record_date),data = MI_all)
summary(narrow_frequency)


# median amplitude
narrow_amplitude <- lmer(MI_all$MI_median_amp ~ narrow_type + event_type + narrow_type*event_type + 
            (1 | MI_all$record_date),data = MI_all)
summary(narrow_amplitude)

# 3.) pain v.s non-pain type

# frequency
pain_frequency <- lmer(
  MI_freq ~ pain_innocuous + event_type + pain_innocuous * event_type + (1 | record_date),
  data = MI_all
)
summary(pain_frequency)

# median amplitude
pain_amplitude <- lmer(
  MI_median_amp ~ pain_innocuous + event_type + pain_innocuous * event_type + (1 | record_date),
  data = MI_all
)
summary(pain_amplitude)

