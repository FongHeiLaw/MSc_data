get_stats_spontaneous <- function(df, 
                      t_min, 
                      t_max,
                      time_col = "relative_time", 
                      amp_col = "Amplitude (pA)", 
                      record_col = "Record",
                      baseline_col = "Baseline (pA)") {
  
  window_length <- t_max - t_min
  
  # Step 1: compute stats per record
  result_spontaneous <- df |>
    group_by(.data[[record_col]]) |>
    summarise(
      n_before_stim = sum(
        !is.na(.data[[time_col]]) &
        .data[[time_col]] >= t_min &
        .data[[time_col]] <= t_max
      ),
      
      avg_amp_before_stim = abs(mean(
        .data[[amp_col]][
          !is.na(.data[[time_col]]) &
          .data[[time_col]] >= t_min &
          .data[[time_col]] <= t_max
        ],
        na.rm = TRUE)
      ),
            
      avg_baseline_before_stim = mean(
        .data[[baseline_col]][
          !is.na(.data[[baseline_col]]) &
          .data[[time_col]] >= t_min &
          .data[[time_col]] <= t_max
        ],
        na.rm = TRUE
      ),
      
      
      frequency_before_stim = n_before_stim / window_length,
      .groups = "drop"
    )
  
  # Step 2: join back into original dataframe
  df_spontaneous <- df |>
    left_join(result_spontaneous, by = record_col)
  
  # Step 3: return BOTH objects
  return(list(
    summary_table_pre_stim = result_spontaneous,
    joined_df_pre_stim = df_spontaneous
  ))
}
