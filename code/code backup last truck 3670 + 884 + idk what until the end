library(ggplot2)

direction <- -1
rise_s <- 0.5 / 1000
decay_s <- 5.0 / 1000

b0 <- 0
b1 <- 1

x <- seq(0, 20 / 1000, length.out = 2000)


biexp_event_function <- function(x, b0, b1, rise, decay) {
  b0 + b1 * (1 - exp(-x / rise)) * exp(-x / decay)
}

y <- direction * biexp_event_function(
  x,
  b0,
  b1,
  rise_s,
  decay_s
)


df <- data.frame(
  time_ms = x * 1000,
  amplitude = y
)


epsc<- ggplot(df, aes(x = time_ms, y = amplitude)) +
  geom_line(linewidth = 1.2, colour = "steelblue") +
  labs(
    title = "E",
    x = "Time (ms)",
    y = "Amplitude"
  ) +
  annotate(
  "text",
  x = 12,
  y = min(y) * 0.5,
  label = "f(x) == b[0] + b[1] * (1 - e^{-x/rise}) * e^{-x/decay}",
  parse = TRUE,
  size = 5)+
  theme_classic() +
  theme(
    legend.position = "none",
    plot.title = element_text(hjust = 0.5, face = "bold", size = 12),
    axis.text = element_text(color = "black", size = 12),
    axis.title = element_text(face = "plain", size = 12),
