## ================================================================
## TIDYING WRITE-UP THESIS
## Step 1: test outcome distribution -> Step 2: pick GLMM family
## Step 3: fit all 6 models with detailed output
## ================================================================

# ---- packages ----
library(lme4)
library(lmerTest)
library(glmmTMB)     # needed for beta-family GLMM (bounded outcomes)
library(readr)

# ---- read data ----
MI_all <- read.csv("C:/Users/silic/Desktop/MI_all.csv")

# ---- ensure correct data type ----
MI_all$file_prefix        <- as.factor(MI_all$file_prefix)
MI_all$event_type         <- as.factor(MI_all$event_type)
MI_all$broad_type         <- as.factor(MI_all$broad_type)
MI_all$narrow_type        <- as.factor(MI_all$narrow_type)
MI_all$pain_innocuous     <- as.factor(MI_all$pain_innocuous)
MI_all$record_date        <- as.factor(MI_all$record_date)
MI_all$Cell               <- as.factor(MI_all$Cell)
MI_all$global_cell_number <- as.factor(MI_all$global_cell_number)

summary(MI_all)
unique(MI_all$record_date)


## ================================================================
## STEP 1 — TEST DISTRIBUTION OF OUTCOME VARIABLES
## MI_freq and MI_median_amp are bounded on [-1, 1]
## ================================================================

skewness <- function(x) {
  x <- x[!is.na(x)]; n <- length(x)
  m3 <- sum((x - mean(x))^3) / n
  m2 <- sum((x - mean(x))^2) / n
  m3 / m2^1.5
}
kurtosis <- function(x) {
  x <- x[!is.na(x)]; n <- length(x)
  m4 <- sum((x - mean(x))^4) / n
  m2 <- sum((x - mean(x))^2) / n
  m4 / m2^2 - 3
}

check_distribution <- function(x, name) {
  x <- x[!is.na(x)]
  cat("\n================", name, "================\n")
  cat("n =", length(x), " range = [", min(x), ",", max(x), "]\n")
  cat("mean =", round(mean(x), 4), " sd =", round(sd(x), 4), "\n")
  cat("skewness =", round(skewness(x), 3),
      " kurtosis (excess) =", round(kurtosis(x), 3), "\n")

  # proportion of values sitting exactly at the -1/0/1 boundaries
  cat("proportion at -1:", mean(x == -1),
      " at 0:", mean(x == 0),
      " at 1:", mean(x == 1), "\n")

  sw <- shapiro.test(sample(x, min(5000, length(x))))  # shapiro caps at n=5000
  print(sw)

  hist(x, breaks = 40, main = paste("Histogram:", name), col = "grey80")
  qqnorm(x, main = paste("Q-Q plot:", name)); qqline(x, col = "red")
}

check_distribution(MI_all$MI_freq,       "MI_freq")
check_distribution(MI_all$MI_median_amp, "MI_median_amp")


## ================================================================
## STEP 2 — SELECT THE RIGHT GLMM FAMILY
## Decision rule:
##  - If Shapiro-Wilk is NOT significant (p > .05) and skew/kurtosis
##    are small (~|skew| < 1, |excess kurtosis| < 1) -> Gaussian LMM
##    (lme4::lmer) is defensible.
##  - Otherwise (bounded, skewed, or boundary mass) -> rescale to
##    (0,1) and fit a Beta GLMM (glmmTMB, family = beta_family()),
##    which respects the [-1,1] boundedness that Gaussian ignores.
##
## Below we build the (0,1)-rescaled version of each outcome so the
## beta-family models are ready to go; keep or drop this branch
## based on what Step 1 told you about each variable.
## ================================================================

# Smithson & Verkuilen (2006) squeeze: keeps values strictly inside (0,1)
# even if some observations sit exactly on the -1/1 boundary
squeeze_to_beta <- function(x) {
  y <- (x + 1) / 2                      # [-1,1] -> [0,1]
  n <- sum(!is.na(y))
  (y * (n - 1) + 0.5) / n                # [0,1] -> (0,1)
}

MI_all$MI_freq_beta       <- squeeze_to_beta(MI_all$MI_freq)
MI_all$MI_median_amp_beta <- squeeze_to_beta(MI_all$MI_median_amp)


## ================================================================
## STEP 3 — FIT ALL 6 MODELS, DETAILED OUTPUT
## Swap the family in fit_model() below once Step 1/2 tell you which
## branch applies to each outcome (gaussian lmer vs. beta glmmTMB).
## ================================================================

fit_model_gaussian <- function(formula, data) {
  m <- lmer(formula, data = data)
  print(summary(m))
  print(confint(m, method = "Wald"))
  m
}

fit_model_beta <- function(formula, data) {
  m <- glmmTMB(formula, data = data, family = beta_family(link = "logit"))
  print(summary(m))
  print(confint(m))
  m
}

# ---- 1. broad type ----

broad_amplitude <- fit_model_beta(
  MI_median_amp_beta ~ broad_type * event_type + (1 | record_date),
  data = MI_all
)

broad_frequency <- fit_model_beta(
  MI_freq_beta ~ broad_type * event_type + (1 | record_date),
  data = MI_all
)

# ---- 2. narrow type ----

narrow_frequency <- fit_model_beta(
  MI_freq_beta ~ narrow_type * event_type + (1 | record_date),
  data = MI_all
)

narrow_amplitude <- fit_model_beta(
  MI_median_amp_beta ~ narrow_type * event_type + (1 | record_date),
  data = MI_all
)

# ---- 3. pain vs. non-pain type ----

pain_frequency <- fit_model_beta(
  MI_freq_beta ~ pain_innocuous * event_type + (1 | record_date),
  data = MI_all
)

pain_amplitude <- fit_model_beta(
  MI_median_amp_beta ~ pain_innocuous * event_type + (1 | record_date),
  data = MI_all
)
