# function to check na of my data frame of big event table, logic suggested by Copilot, modified by me to make it understandable, e.g I dont like using try except, and i dont like using pandas etc, also debugged by Copilot, for loop wrote complteely by me
def count_na(list_of_dictionary_with_each_element_as_an_event, column_name_to_check_na):
    empty_list= [] # create empty list
    for event in list_of_dictionary_with_each_element_as_an_event:

        # fetch the value of the defined column, if it is na/ "", append na using np.nan, otherwise, append the raw value float, then can count na later
        value = event[column_name_to_check_na]
        
        # check for NA before converting
        if value is None:
            empty_list.append(np.nan)
        elif value == "":
            empty_list.append(np.nan)

        elif str(value).lower() in ["nan", "none", "inf", "-inf"]:  
            empty_list.append(np.nan)

        else:
            empty_list.append(float(value))
            
    array_np = np.array(empty_list) # convert the list to NumPy array
    return np.sum(np.isnan(array_np)) # count how many is na


