    n_events   = n(),
    mean_amp   = mean(amplitude_raw, na.rm = TRUE),
    median_amp = median(amplitude_raw, na.rm = TRUE),
    mad_amp    = mad(amplitude_raw, na.rm = TRUE),
    sd_amp     = sd(amplitude_raw, na.rm = TRUE),
