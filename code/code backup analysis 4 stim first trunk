df <- df |>
  rename(
    event_time   = "Event.Time..s.",
    amplitude    = "Amplitude..pA.",
    event_type   = mV,       
    stim_start   = stim_abs_time,
    baseline_start = baseline_period_start_time
  )


# calculate pre/post from event time vs stimulus time, still same nrow
df <- df |>
  mutate(
    pre_or_post = case_when(
      event_time >= baseline_start & event_time < baseline_start + 5 ~ "pre",
      event_time > stim_start & event_time <= stim_start + stim_period_duration ~ "post",
      TRUE ~ NA_character_
    ),
    amplitude_raw = amplitude,
    amplitude = abs(amplitude)
  ) |>
  filter(!is.na(pre_or_post))
