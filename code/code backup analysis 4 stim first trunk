    .groups = "drop"
  ) |>
  left_join(records_per_file, by = "file_prefix") |>
  left_join(stim_duration_per_file, by = "file_prefix") |>
  mutate(
    duration = if_else(pre_or_post == "pre", 5 * n_records, stim_period_duration * n_records),
    freq = n_events / duration
  )



