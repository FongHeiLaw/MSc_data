df_bup <- df


summary_df |> 
  filter(is.na(sd_amp)) |>
  select(file_prefix)


pre_bins <- df |>
  filter(!is.na(amplitude), pre_or_post == "pre") |>
  mutate(
    bin = case_when(
      event_time >= baseline_start + 0 & event_time < baseline_start + 1 ~ 0,
      event_time >= baseline_start + 1 & event_time < baseline_start + 2 ~ 1,
      event_time >= baseline_start + 2 & event_time < baseline_start + 3 ~ 2,
      event_time >= baseline_start + 3 & event_time < baseline_start + 4 ~ 3,
      event_time >= baseline_start + 4 & event_time < baseline_start + 5 ~ 4,
      TRUE ~ NA_real_
    )
  ) |>
  filter(!is.na(bin)) |>
  group_by(file_prefix, event_type, bin) |>
  summarise(n_events_in_bin = n(), .groups = "drop") |>
  group_by(file_prefix, event_type) |>
  complete(bin = 0:4, fill = list(n_events_in_bin = 0)) |>
  left_join(records_per_file, by = "file_prefix") |>          # <- bring in n_records per file
  mutate(freq_hz_in_bin = n_events_in_bin / n_records) |>      # <- scale by number of Records pooled
  summarise(
    mean_pre_freq = mean(freq_hz_in_bin),
    sd_pre_freq   = sd(freq_hz_in_bin),
    .groups = "drop"
  )



# get the pre sitmn sd

summary_df_sorted_correct <- summary_df_sorted_correct |>
  left_join(
    pre_bins |> select(file_prefix, sd_pre_freq),
    by = "file_prefix"
  )

summary(summary_df_sorted_correct)
# no na in sd pre frequency!!!
