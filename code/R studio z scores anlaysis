### 1. Count how many Records exist per file_prefix 
records_per_file <- df |>
  group_by(file_prefix) |>
  summarise(n_records = n_distinct(Record), .groups = "drop")

View(records_per_file)

### 2. Get stim_period_duration per file 
stim_duration_per_file <- df |>
  group_by(file_prefix) |>
  summarise(stim_period_duration = first(stim_period_duration), .groups = "drop")

View(stim_duration_per_file)


#View(df)

### 3. Pooled event counts per file_prefix / event_type / pre_or_post
summary_df <- df |>
  group_by(file_prefix, pre_or_post) |>
  summarise(
    n_events   = n(),
    mean_amp   = mean(amplitude_raw, na.rm = TRUE),
    median_amp = median(amplitude_raw, na.rm = TRUE),
    mad_amp    = mad(amplitude_raw, na.rm = TRUE),
    sd_amp     = sd(amplitude_raw, na.rm = TRUE),
    sem_amp    = sd(amplitude_raw, na.rm = TRUE) / sqrt(n_events),
    .groups = "drop"
  ) |>
  left_join(records_per_file, by = "file_prefix") |>
  left_join(stim_duration_per_file, by = "file_prefix") |>
  mutate(
    duration = if_else(pre_or_post == "pre", 5 * n_records, stim_period_duration * n_records),
    freq = n_events / duration
  )



summary_df_sorted_correct <- summary_df |>
  arrange(n_events)

View(summary_df_sorted_correct)

summary(summary_df_sorted_correct)
