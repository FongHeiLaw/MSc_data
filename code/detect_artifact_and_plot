print(f"buffer: {return_buffer} pA")



all_artifacts = []


for file_number, abf_path in enumerate(abf_files,start=1):

    filename = os.path.basename(abf_path)


    try:
        abf = pyabf.ABF(abf_path)

        for sweep_number in range(abf.sweepCount):

            abf.setSweep(sweep_number)


            data = np.asarray(abf.sweepY,dtype=float)

            times = np.asarray(abf.sweepX,dtype=float)

            artifacts = find_sharp_artifacts(
                data=data,
                times=times,
                amp_threshold=amp_threshold,
                return_win_samp=return_win_samp,
                return_buffer=return_buffer)


            if len(artifacts) > 0:

                plot_path = save_artifact_plot(

                    data=data,

                    times=times,

                    artifacts_list=artifacts,

                    filename=filename,

                    sweep_number=sweep_number,

                    plot_folder=plot_folder
                )


            for artifact_number, artifact in enumerate(
                artifacts,
                start=1 ):

                artifact_row = {"file":filename,
                                "file_path":abf_path,
                                "sweep":sweep_number,
                                "artifact_number":artifact_number,**artifact,}
                all_artifacts.append(artifact_row)

                start_idx = artifact["start_sample"]

                end_idx = artifact["return_sample"]

    except Exception as e:
        print(f"error processing {filename}: {e}")



summary_df = pd.DataFrame(all_artifacts)


