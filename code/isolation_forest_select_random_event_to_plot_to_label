select_events_to_label <- function(df, n_outliers = 50, n_not_outliers = 20, seed = 0) {

  # 3. Sort by score
  outliers_table_sorted <- outliers_table[order(outliers_table$outlier_score, decreasing = TRUE), ]# sort by biggest first

  # 4. Top-N outliers
  n_outliers <- min(n_outliers, nrow(outliers_table_sorted))
  outlier_part <- outliers_table_sorted[1:n_outliers, ] # get the top 50 outliers rows, all columns
  outlier_part$is_outlier <- "yes"

  # 5. Remaining events
  remaining <- outliers_table_sorted[(n_outliers + 1):nrow(outliers_table_sorted), ] # get the remainig non outliers

  # 6. Random sample from remaining
  set.seed(seed)
  n_not_outliers <- min(n_not_outliers, nrow(remaining)) # if random (non ouliers) is fewer than the remaining row, just put the remianing row number assign this as our random value (for plotting non outliers)
  random_idx <- sample(nrow(remaining), n_not_outliers) # draw n_not_outliers from our remaining row numbers
  random_part <- remaining[random_idx, ]
  random_part$is_outlier <- "no"

  # 7. Combine and shuffle
  combined <- rbind(outlier_part, random_part)


  return(combined)
}

