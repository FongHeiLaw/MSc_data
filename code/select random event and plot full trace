# load metadata so that I can plot the mV number as plot title
matadata_file_path = r"C:/Users/silic/Desktop/metadata_with_base_name_23_to_26_updated.csv"
metadata_df = metadata_lookup.load_metadata(matadata_file_path)

# fetch the mV number of this recording, store as settings[2]
settings = metadata_lookup.get_settings_for_file(filepath, metadata_df) # this function output a list that has three elements, threshold, direction (-1/1), and mV (0/-70)
#threshold_lower, direction, mv = settings # unpack
#print(settings[2]) # this print the mV into console


# exact same code used in batch processing event detection
importer = ephys.importdata.ImportData(filepath, ext = ".ABF")
data = importer.load_data()
primary_data = data.get_primary_data()
time_array = data.time_array
time_array = time_array - offset
# offset is 0.028 for mechanical stimulator, 0.021 for 4stim and mechanical stimulator

FILTFS = [50, 150] # my butterworth filter bandstop bandpass, if this vafriable is NONE, it means dont filter

for rec in range(data.num_recs):
    print(f"Processing record {rec+1}/{data.num_recs}")

    data_array = primary_data[rec, :]
    time_ = time_array[rec, :]

    # sampling rate in Hz
    fs = 1.0 / float(data.ts)

    # don't filter the stimulation period
    # for example: leave 4-10 seconds untouched for mechanical stimulator
    # leave 10.9 to 24.9 untouched for thermal stimulator
    excluded_index_ranges = [(int(start_exc_region * fs), int(stop_exc_region * fs))]
    # data.ts is in seconds,  filter_minis expects milliseconds, so convert it with by multiplying 1000
    data_array = filter_minis(
        data_array,
        dt_ms=float(data.ts) * 1000,
        filtfs = FILTFS,
        n_sweeps=1,  # each record is filtered individually here
        excluded_index_ranges=excluded_index_ranges,
    )
    print("filtered this record")

    plt.figure(figsize=(12, 4))
    title = f"sweep {rec} voltage clamp at {settings[2]} mV {os.path.basename(filepath)}"
    plt.title(title, fontsize=8)
    plt.plot(time_, data_array, linewidth=0.5, color="black", zorder=1)
    plt.show()




